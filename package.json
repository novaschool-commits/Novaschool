{
  "name": "nova-school-app",
  "version": "1.0.0",
  "description": "Nova School \u2014 a full-stack online school platform (Express + PostgreSQL, static frontend).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node db/seed.js --force",
    "migrate": "node db/migrate.js",
    "migrate:status": "node db/migrate.js --status",
    "test": "node --test tests/unit/*.test.js",
    "test:db": "bash tests/db/run.sh",
    "test:api": "node --test tests/api/*.test.js",
    "db:schema": "node db/schema-setup.js",
    "db:app-login": "node db/app-login.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}

# Copy to .env for local use. Placeholders only: never commit real values.

PORT=3000

# Postgres connection used by the running app.
# Local example: postgresql://postgres@localhost:5432/nova_dev
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Required in production (Render): at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Creates demo accounts (password "password123") on an EMPTY database.
# Local throwaway databases only; always off in production.
SEED_DEMO=false

# Re-apply the legacy idempotent db/schema.sql at start (current behaviour).
# Set to false once migrations are run only through `npm run migrate`.
MIGRATE_ON_START=true

# Owner-role connection used ONLY by `npm run migrate` (falls back to DATABASE_URL).
MIGRATION_DATABASE_URL=

# Gate for db/migrations/0004_tenancy_rls.sql. Leave false until the app sets a
# school context on every request (multi-school Phase P3).
ALLOW_RLS_ENFORCEMENT=false

# Verify the database's TLS certificate. Test against Neon before turning on.
PGSSL_REJECT_UNAUTHORIZED=false

# Extra origins allowed to call the API from a browser (comma separated).
# Empty = same origin only.
ALLOWED_ORIGINS=

# Number of proxies in front of the app that add X-Forwarded-For (Render: 1).
TRUST_PROXY_HOPS=1
